# Copy to .env and adjust. Validated at startup by src/config/env.ts.
NODE_ENV=development
PORT=4000
# The web app's origin, allowed by CORS (with credentials).
WEB_ORIGIN=http://localhost:3000
# Local replica set from infra/docker-compose.dev.yml (`pnpm infra:up`).
MONGODB_URI=mongodb://localhost:27017/makemymarriage?directConnection=true

# Email (used by the worker). smtp sends to Mailpit locally: http://localhost:8025
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=Make My Marriage <no-reply@localhost>
# Production: EMAIL_TRANSPORT=resend, RESEND_API_KEY=..., EMAIL_FROM on mail.makemymarriage.com
# RESEND_API_KEY=
# Resend free plan: 100 emails a day; 20 always kept for login codes and organiser invitations.
EMAIL_DAILY_LIMIT=100
EMAIL_RESERVED=20
