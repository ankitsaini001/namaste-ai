# Copy to infra/.env on the API server. Read by docker-compose.prod.yml (see infra/README.md).

# The API's address, without https://. Until the domain is set up, use the server's fixed IP
# with dashes instead of dots, plus .sslip.io (13.235.10.20 becomes 13-235-10-20.sslip.io).
API_HOST=api.makemymarriage.com
